---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { formatDate } from "../lib/content";
import { sitePath } from "../lib/site";

const [media, projects] = await Promise.all([
  getCollection("media"),
  getCollection("projects"),
]);
const publishedMedia = media
  .filter((item) => !item.data.demo)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const projectsById = new Map(projects.map((project) => [project.id, project]));
---

<BaseLayout
  title="In the Media"
  description="A catalogue of external media coverage related to ARISE research."
>
  <PageHeader
    eyebrow="In the Media"
    title="ARISE research in the media."
    intro="Coverage of ARISE research, with links to the original publishers."
  />

  <section class="section">
    <div class="shell">
      <div class="media-list">
        {
          publishedMedia.map((item) => {
            const project = item.data.project
              ? projectsById.get(item.data.project.id)
              : undefined;
            return (
              <article class="media-item">
                <div>
                  <p class="media-item__source">{item.data.source}</p>
                  <p class="media-item__date">
                    <time datetime={item.data.date.toISOString()}>
                      {formatDate(item.data.date)}
                    </time>
                  </p>
                </div>
                <div>
                  <h2>{item.data.title}</h2>
                  {item.data.summary && <p>{item.data.summary}</p>}
                  {project && (
                    <p class="media-item__project">
                      Related research:{" "}
                      <a href={sitePath(`/research/${project.id}/`)}>
                        {project.data.title}
                      </a>
                    </p>
                  )}
                </div>
                <div class="media-item__action">
                  {item.data.externalUrl ? (
                    <a class="text-link" href={item.data.externalUrl}>
                      Read original <span aria-hidden="true">↗</span>
                    </a>
                  ) : (
                    <span class="pending-link">
                      External link pending verification
                    </span>
                  )}
                </div>
              </article>
            );
          })
        }
        {
          publishedMedia.length === 0 && (
            <p class="empty-state">Verified media coverage will appear here.</p>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>
