---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import DemoBadge from "../components/DemoBadge.astro";
import InstitutionMark from "../components/InstitutionMark.astro";
import { sitePath } from "../lib/site";

const institutions = (await getCollection("institutions")).sort(
  (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999),
);
const programmeInstitutions = institutions.filter(
  (item) => item.data.relationship === "Named programme collaborator",
);
const contributorInstitutions = institutions.filter(
  (item) => item.data.relationship === "Contributor affiliation",
);
---

<BaseLayout
  title="Institutions / Contact"
  description="Verified institutional relationships and contact information for the ARISE website demonstrator."
>
  <PageHeader
    eyebrow="Institutions / Contact"
    title="An international programme needs shared ownership and clear routes in."
    intro="Universities are presented here through evidenced programme collaboration or researcher affiliation. Funding bodies have their own page so the two relationships are not conflated."
  />

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">Programme collaboration</p>
        <h2>Named collaborating universities</h2>
      </div>
      <div class="institution-grid">
        {
          programmeInstitutions.map((institution) => (
            <article class="institution-card">
              <InstitutionMark institution={institution} showApprovalNote />
              {institution.data.demo && <DemoBadge />}
              <h3>
                <a href={sitePath(`/institutions/${institution.id}/`)}>
                  {institution.data.name}
                </a>
              </h3>
              {institution.data.countryOrRegion && (
                <p class="institution-card__region">
                  {institution.data.countryOrRegion}
                </p>
              )}
              <p>{institution.data.summary}</p>
              <a
                class="card-link"
                href={sitePath(`/institutions/${institution.id}/`)}
              >
                View record <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="shell">
      <div class="section-heading section-heading--row">
        <div>
          <p class="eyebrow">Publication network</p>
          <h2>Other verified contributor affiliations</h2>
        </div>
        <p class="section-note">
          An author affiliation does not by itself imply programme membership.
        </p>
      </div>
      <div class="institution-grid institution-grid--compact">
        {
          contributorInstitutions.map((institution) => (
            <article class="institution-card">
              <InstitutionMark institution={institution} showApprovalNote />
              <h3>
                <a href={sitePath(`/institutions/${institution.id}/`)}>
                  {institution.data.name}
                </a>
              </h3>
              <p>{institution.data.summary}</p>
              {institution.data.statusNote && (
                <p class="verification-note">{institution.data.statusNote}</p>
              )}
              <a
                class="card-link"
                href={sitePath(`/institutions/${institution.id}/`)}
              >
                View record <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell logo-governance">
      <div>
        <p class="eyebrow">Institutional identity</p>
        <h2>Official-source marks, included provisionally.</h2>
      </div>
      <div>
        <p>
          Each logo is stored with alt text, its official source and a short
          usage note. The marks help this working demonstrator show how a
          consortium identity could be presented; they do not replace each
          institution's brand-approval process.
        </p>
        <p class="verification-note">
          Before an official launch, the consortium must confirm permission,
          approved variants, clear space and ordering with the relevant brand
          owners.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="shell contact-panel">
      <div>
        <p class="eyebrow">Contact</p>
        <h2>Programme contact details to be confirmed.</h2>
      </div>
      <div>
        <p>
          The consortium should agree the public contact route and who owns
          responses before an email address or contact form is published. This
          demonstrator deliberately does not invent one.
        </p>
        <p class="verification-note">
          Decision needed: programme contact, editorial owner and repository
          access model.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
