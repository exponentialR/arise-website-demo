---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import InstitutionMark from "../components/InstitutionMark.astro";
import { sitePath } from "../lib/site";

const institutions = (await getCollection("institutions")).sort(
  (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999),
);
const programmeInstitutions = institutions.filter(
  (item) => item.data.relationship === "Named programme collaborator",
);
const contributorInstitutions = institutions.filter(
  (item) => item.data.relationship === "Contributor affiliation",
);
---

<BaseLayout
  title="Institutions / Contact"
  description="Institutions contributing to ARISE and programme contact information."
>
  <PageHeader
    eyebrow="Institutions / Contact"
    title="An international research collaboration."
    intro="ARISE connects researchers and institutions across Northern Ireland, Ireland and the United States. Funding organisations are presented separately from university participation."
  />

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">Programme collaboration</p>
        <h2>Named collaborating universities</h2>
      </div>
      <div class="institution-grid">
        {
          programmeInstitutions.map((institution) => (
            <article class="institution-card">
              <InstitutionMark institution={institution} />
              <h3>
                <a href={sitePath(`/institutions/${institution.id}/`)}>
                  {institution.data.name}
                </a>
              </h3>
              {institution.data.countryOrRegion && (
                <p class="institution-card__region">
                  {institution.data.countryOrRegion}
                </p>
              )}
              <p>{institution.data.summary}</p>
              <a
                class="card-link"
                href={sitePath(`/institutions/${institution.id}/`)}
              >
                View record <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="shell">
      <div class="section-heading section-heading--row">
        <div>
          <p class="eyebrow">Publication network</p>
          <h2>Other verified contributor affiliations</h2>
        </div>
        <p class="section-note">
          An author affiliation does not by itself imply programme membership.
        </p>
      </div>
      <div class="institution-grid institution-grid--compact">
        {
          contributorInstitutions.map((institution) => (
            <article class="institution-card">
              <InstitutionMark institution={institution} />
              <h3>
                <a href={sitePath(`/institutions/${institution.id}/`)}>
                  {institution.data.name}
                </a>
              </h3>
              <p>{institution.data.summary}</p>
              <a
                class="card-link"
                href={sitePath(`/institutions/${institution.id}/`)}
              >
                View record <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="shell contact-panel">
      <div>
        <p class="eyebrow">Contact</p>
        <h2>Connect with ARISE.</h2>
      </div>
      <div>
        <p>
          A central programme contact will be published here once it has been
          confirmed by the consortium. In the meantime, institutional profile
          links provide routes to the researchers represented on this site.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
