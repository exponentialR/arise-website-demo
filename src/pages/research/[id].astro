---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PersonCard from "../../components/PersonCard.astro";
import PublicationItem from "../../components/PublicationItem.astro";
import { refIds, uniqueById } from "../../lib/content";
import { sitePath } from "../../lib/site";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { Content } = await render(project);

const [people, institutions, publications, resources, media] =
  await Promise.all([
    getCollection("people"),
    getCollection("institutions"),
    getCollection("publications"),
    getCollection("resources"),
    getCollection("media"),
  ]);

const personIds = refIds(project.data.people);
const institutionIds = refIds(project.data.institutions);
const publicationIds = refIds(project.data.relatedPublications);
const resourceIds = refIds(project.data.resources);
const linkedPeople = people.filter((person) => personIds.has(person.id));
const linkedInstitutions = institutions.filter((institution) =>
  institutionIds.has(institution.id),
);
const linkedPublications = uniqueById([
  ...publications.filter((publication) =>
    publication.data.projects.some((reference) => reference.id === project.id),
  ),
  ...publications.filter((publication) => publicationIds.has(publication.id)),
]);
const linkedResources = uniqueById([
  ...resources.filter(
    (resource) =>
      !resource.data.demo &&
      resource.data.projects.some((reference) => reference.id === project.id),
  ),
  ...resources.filter(
    (resource) => !resource.data.demo && resourceIds.has(resource.id),
  ),
]);
const linkedMedia = media.filter(
  (item) => !item.data.demo && item.data.project?.id === project.id,
);
const projectNames = [project.data.title];
---

<BaseLayout title={project.data.title} description={project.data.summary}>
  <section class="project-hero">
    <div class="shell project-hero__grid">
      <div>
        <p class="breadcrumb">
          <a href={sitePath("/research/")}>Research</a><span aria-hidden="true"
            >/</span
          >{project.data.title}
        </p>
        <h1>{project.data.title}</h1>
        <p class="page-hero__intro">{project.data.summary}</p>
      </div>
      <div
        class="project-image-placeholder"
        role="img"
        aria-label={project.data.imageAlt ??
          `${project.data.title} project visual`}
      >
        <span>{project.data.shortTitle ?? project.data.title}</span>
        <small>Intermeshed steel connection research</small>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell detail-layout">
      <article class="prose">
        <Content />
      </article>
      <aside class="detail-sidebar" aria-label="Project details">
        <div class="detail-sidebar__block">
          <p class="detail-label">Institutions</p>
          {
            linkedInstitutions.length > 0 ? (
              <ul class="plain-list">
                {linkedInstitutions.map((institution) => (
                  <li>
                    <a href={sitePath(`/institutions/${institution.id}/`)}>
                      {institution.data.name}
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p>To be confirmed.</p>
            )
          }
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="team-heading">
    <div class="shell">
      <div class="section-heading section-heading--row">
        <div>
          <p class="eyebrow">Connected records</p>
          <h2 id="team-heading">Project people</h2>
        </div>
        <p class="section-note">
          Researchers represented through verified authorship and affiliation.
        </p>
      </div>
      {
        linkedPeople.length > 0 ? (
          <div class="people-grid">
            {linkedPeople.map((person) => (
              <PersonCard
                person={person}
                institutionName={
                  institutions.find(
                    (institution) =>
                      institution.id === person.data.institution?.id,
                  )?.data.name
                }
              />
            ))}
          </div>
        ) : (
          <p class="empty-state">
            No project participants are currently listed.
          </p>
        )
      }
    </div>
  </section>

  <section class="section" aria-labelledby="outputs-heading">
    <div class="shell">
      <div class="section-heading section-heading--row">
        <div>
          <p class="eyebrow">Research outputs</p>
          <h2 id="outputs-heading">Linked publications</h2>
        </div>
        <a class="text-link" href={sitePath("/publications/")}
          >View all publications <span aria-hidden="true">→</span></a
        >
      </div>
      {
        linkedPublications.length > 0 ? (
          <div class="publication-list">
            {linkedPublications.map((publication) => (
              <PublicationItem
                publication={publication}
                authorNames={publication.data.authors.map(
                  (author) => author.name,
                )}
                projectNames={projectNames}
              />
            ))}
          </div>
        ) : (
          <p class="empty-state">
            No verified publications are currently linked to this project.
          </p>
        )
      }
    </div>
  </section>

  <section class="section section--navy" aria-labelledby="resources-heading">
    <div class="shell">
      <div class="section-heading section-heading--row section-heading--light">
        <div>
          <p class="eyebrow">Open routes to the work</p>
          <h2 id="resources-heading">Resources and coverage</h2>
        </div>
        <p class="section-note">
          Data, software and media are linked from their authoritative external
          platforms.
        </p>
      </div>
      <div class="resource-grid">
        {
          linkedResources.map((resource) => (
            <article class="resource-card resource-card--dark">
              <p class="resource-card__type">{resource.data.type}</p>
              <h3>{resource.data.title}</h3>
              <p>{resource.data.summary}</p>
              {resource.data.externalUrl ? (
                <a href={resource.data.externalUrl}>
                  Open external resource <span aria-hidden="true">↗</span>
                </a>
              ) : (
                <span class="pending-link">Link pending verification</span>
              )}
            </article>
          ))
        }
        {
          linkedMedia.map((item) => (
            <article class="resource-card resource-card--dark">
              <p class="resource-card__type">Media · {item.data.source}</p>
              <h3>{item.data.title}</h3>
              <p>{item.data.summary}</p>
              {item.data.externalUrl ? (
                <a href={item.data.externalUrl}>
                  Read original coverage <span aria-hidden="true">↗</span>
                </a>
              ) : (
                <span class="pending-link">
                  External link pending verification
                </span>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
