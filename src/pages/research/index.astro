---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ProjectCard from "../../components/ProjectCard.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999),
);
---

<BaseLayout
  title="Research"
  description="Explore ARISE research projects and their connected people, institutions and outputs."
>
  <PageHeader
    eyebrow="Research"
    title="Research advancing steel building assembly."
    intro="ARISE research connects structural engineering, advanced manufacturing, robotics, perception and the human dimensions of technology adoption."
  />

  <section class="section">
    <div class="shell">
      <div class="section-heading section-heading--row">
        <div>
          <p class="eyebrow">Project directory</p>
          <h2>Research projects</h2>
        </div>
        <p class="section-note">
          Each project brings together its researchers, institutions and related
          outputs.
        </p>
      </div>
      <div
        class:list={[
          "project-grid",
          { "project-grid--single": projects.length === 1 },
        ]}
      >
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>
</BaseLayout>
