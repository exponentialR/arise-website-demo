---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PublicationItem from "../components/PublicationItem.astro";
import NewsCard from "../components/NewsCard.astro";
import HeroResearchVisual from "../components/HeroResearchVisual.astro";
import InstitutionMark from "../components/InstitutionMark.astro";
import FunderMark from "../components/FunderMark.astro";
import HomePersonCard from "../components/HomePersonCard.astro";
import { sitePath } from "../lib/site";

const [
  projects,
  publications,
  news,
  resources,
  institutions,
  funders,
  engagement,
  people,
] = await Promise.all([
  getCollection("projects"),
  getCollection("publications"),
  getCollection("news"),
  getCollection("resources"),
  getCollection("institutions"),
  getCollection("funders"),
  getCollection("engagement"),
  getCollection("people"),
]);

const latestPublications = publications
  .sort(
    (a, b) =>
      b.data.year - a.data.year || a.data.title.localeCompare(b.data.title),
  )
  .slice(0, 3);
const latestNews = news
  .filter((item) => !item.data.demo)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const featuredResources = resources
  .filter((resource) => !resource.data.demo)
  .slice(0, 3);
const projectsById = new Map(projects.map((project) => [project.id, project]));
const orderedInstitutions = institutions.sort(
  (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999),
);
const programmeInstitutions = orderedInstitutions.filter(
  (institution) =>
    institution.data.relationship === "Named programme collaborator",
);
const orderedFunders = funders.sort(
  (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999),
);
const latestEngagement = engagement
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const institutionsById = new Map(
  institutions.map((institution) => [institution.id, institution]),
);
const peopleById = new Map(people.map((person) => [person.id, person]));
const featuredPeopleIds = [
  "debra-laefer",
  "david-hester",
  "daniel-mcpolin",
  "karen-rafferty",
  "samuel-adebayo",
  "miftahur-rahman",
];
const featuredPeople = featuredPeopleIds.flatMap((id) => {
  const person = peopleById.get(id);
  return person ? [person] : [];
});
---

<BaseLayout
  title="ARISE"
  description="ARISE brings together research in steel building assembly, structural engineering, advanced manufacturing, robotics and technology adoption."
>
  <section class="hero">
    <div class="shell hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">International research programme</p>
        <h1>Reimagining how steel buildings come together.</h1>
        <p class="hero__intro">
          ARISE—Assembly and Robotics Innovation in Steel Building
          Erection—brings together interdisciplinary research spanning
          structural engineering, advanced manufacturing, robotics and the human
          dimensions of technology adoption.
        </p>
        <div class="button-row">
          <a class="button" href={sitePath("/research/")}
            >Explore the research</a
          >
          <a class="text-link" href={sitePath("/people/")}
            >Meet the research community <span aria-hidden="true">→</span></a
          >
        </div>
      </div>
      <HeroResearchVisual />
    </div>
    <div class="shell hero-themes" aria-label="ARISE research themes">
      <span>Structural systems</span>
      <span>Advanced manufacturing</span>
      <span>Robotics &amp; perception</span>
      <span>Human-centred adoption</span>
    </div>
  </section>

  <section class="programme-intro" aria-labelledby="programme-intro-heading">
    <div class="shell programme-intro__grid">
      <div>
        <p class="eyebrow">A connected research challenge</p>
        <h2 id="programme-intro-heading">
          From engineered connections to the people and systems that assemble
          them.
        </h2>
      </div>
      <div class="programme-intro__body">
        <p>
          ARISE connects structural engineering, construction, robotics and
          technology research across an international university partnership.
          The programme examines steel building erection as a whole system—not
          as a single technical problem.
        </p>
        <ol class="research-thread-list">
          <li><span>01</span> Design connections for new assembly methods</li>
          <li><span>02</span> Develop perception and robotic capabilities</li>
          <li><span>03</span> Study implementation in construction practice</li>
        </ol>
      </div>
    </div>
  </section>

  <section class="context-strip" aria-labelledby="context-heading">
    <div class="shell">
      <div class="institution-rail__heading">
        <p id="context-heading">A US–Ireland research collaboration</p>
        <a href={sitePath("/partners-contact/")}
          >Institutions <span aria-hidden="true">→</span></a
        >
      </div>
      <div class="name-grid">
        {
          programmeInstitutions.map((institution) => (
            <a
              class="institution-tile"
              href={sitePath(`/institutions/${institution.id}/`)}
            >
              <InstitutionMark institution={institution} />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section research-feature" aria-labelledby="research-heading">
    <div class="shell">
      <div class="section-heading section-heading--row">
        <div>
          <p class="eyebrow">Research in focus</p>
          <h2 id="research-heading">Research across the assembly system.</h2>
        </div>
        <div>
          <p class="section-note">
            Explore connected areas of enquiry spanning engineered systems,
            robotics and construction practice.
          </p>
          <a class="text-link" href={sitePath("/research/")}
            >View all research <span aria-hidden="true">→</span></a
          >
        </div>
      </div>
      <div class="home-research-grid">
        <article>
          <span>01</span>
          <h3>Structural systems</h3>
          <p>
            Connection concepts, structural performance and new approaches to
            steel assembly.
          </p>
        </article>
        <article>
          <span>02</span>
          <h3>Manufacturing &amp; assembly</h3>
          <p>
            The relationship between connection design, fabrication and
            efficient building erection.
          </p>
        </article>
        <article>
          <span>03</span>
          <h3>Robotics &amp; perception</h3>
          <p>
            Computer vision, datasets, manipulation and control for robotic
            assembly tasks.
          </p>
        </article>
        <article>
          <span>04</span>
          <h3>Implementation &amp; safety</h3>
          <p>
            Worker safety, ergonomics and the human dimensions of technology
            adoption in construction.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section people-feature" aria-labelledby="people-heading">
    <div class="shell">
      <div class="section-heading section-heading--row">
        <div>
          <p class="eyebrow">Research community</p>
          <h2 id="people-heading">People shaping the work.</h2>
        </div>
        <div>
          <p class="section-note">
            Researchers across structures, construction, robotics and emerging
            technology.
          </p>
          <a class="text-link" href={sitePath("/people/")}
            >Meet the full team <span aria-hidden="true">→</span></a
          >
        </div>
      </div>
      <div class="home-people-grid">
        {
          featuredPeople.map((person, index) => (
            <HomePersonCard
              person={person}
              position={index}
              institutionName={
                person.data.institution
                  ? institutionsById.get(person.data.institution.id)?.data.name
                  : undefined
              }
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="publications-heading">
    <div class="shell">
      <div class="section-heading section-heading--row">
        <div>
          <p class="eyebrow">Latest research outputs</p>
          <h2 id="publications-heading">Publications</h2>
        </div>
        <a class="text-link" href={sitePath("/publications/")}
          >Browse all publications <span aria-hidden="true">→</span></a
        >
      </div>
      <div class="publication-list">
        {
          latestPublications.map((publication) => (
            <PublicationItem
              publication={publication}
              authorNames={publication.data.authors.map(
                (author) => author.name,
              )}
              projectNames={publication.data.projects.map(
                (reference) =>
                  projectsById.get(reference.id)?.data.title ?? reference.id,
              )}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="funding-strip" aria-labelledby="funding-strip-heading">
    <div class="shell funding-strip__grid">
      <div>
        <p class="eyebrow">Publicly funded research</p>
        <h2 id="funding-strip-heading">
          Supporting collaboration across three jurisdictions.
        </h2>
        <p class="section-note">
          Award identifiers and linked outputs are drawn from official award,
          publisher and proceedings records.
        </p>
        <a class="text-link" href={sitePath("/funding/")}
          >View funding and awards <span aria-hidden="true">→</span></a
        >
      </div>
      <div class="funder-mini-grid">
        {
          orderedFunders.map((funder) => (
            <a href={sitePath(`/funding/${funder.id}/`)}>
              <FunderMark funder={funder} compact />
              <small>{funder.data.jurisdiction}</small>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="engagement-heading">
    <div class="shell">
      <div class="section-heading section-heading--row">
        <div>
          <p class="eyebrow">Presentations and outreach</p>
          <h2 id="engagement-heading">Research in public</h2>
        </div>
        <div>
          <p class="section-note">
            Talks, exhibitions, workshops and public engagement from across the
            programme.
          </p>
          <a class="text-link" href={sitePath("/engagement/")}
            >Explore engagement <span aria-hidden="true">→</span></a
          >
        </div>
      </div>
      <div class="engagement-grid">
        {
          latestEngagement.map((item) => (
            <article class="engagement-card">
              <p class="engagement-card__meta">
                {item.data.type} · {item.data.date.getFullYear()}
              </p>
              <h3>
                <a href={sitePath(`/engagement/${item.id}/`)}>
                  {item.data.title}
                </a>
              </h3>
              <p>{item.data.summary}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {
    latestNews.length > 0 && (
      <section class="section" aria-labelledby="news-heading">
        <div class="shell">
          <div class="section-heading section-heading--row">
            <div>
              <p class="eyebrow">From the programme</p>
              <h2 id="news-heading">Latest news</h2>
            </div>
            <a class="text-link" href={sitePath("/news/")}>
              All news <span aria-hidden="true">→</span>
            </a>
          </div>
          <div class="news-grid">
            {latestNews.map((item) => (
              <NewsCard item={item} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    featuredResources.length > 0 && (
      <section
        class="section section--navy"
        aria-labelledby="resources-heading"
      >
        <div class="shell">
          <div class="section-heading section-heading--row section-heading--light">
            <div>
              <p class="eyebrow">Beyond the publication</p>
              <h2 id="resources-heading">Research resources</h2>
            </div>
            <div>
              <p class="section-note">
                Data, software and supporting material from across the
                programme.
              </p>
              <a
                class="text-link text-link--light"
                href={sitePath("/resources/")}
              >
                Browse resources <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
          <div class="resource-grid">
            {featuredResources.map((resource) => (
              <article class="resource-card resource-card--dark">
                <div class="card-meta">
                  <span>{resource.data.type}</span>
                </div>
                <h3>{resource.data.title}</h3>
                <p>{resource.data.summary}</p>
                {resource.data.externalUrl && (
                  <a href={resource.data.externalUrl}>
                    Open resource <span aria-hidden="true">↗</span>
                  </a>
                )}
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
