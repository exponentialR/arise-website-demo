---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import PersonCard from "../../components/PersonCard.astro";

const [people, institutions] = await Promise.all([
  getCollection("people"),
  getCollection("institutions"),
]);
people.sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
const institutionsById = new Map(
  institutions.map((institution) => [institution.id, institution]),
);
---

<BaseLayout
  title="People"
  description="Meet the researchers contributing to ARISE and explore their institutions, projects and publications."
>
  <PageHeader
    eyebrow="People"
    title="People contributing to ARISE research."
    intro="Meet researchers and authors connected to the programme through their institutions, projects and publications."
  />

  <section class="section">
    <div class="shell">
      <div class="section-heading section-heading--row">
        <div>
          <p class="eyebrow">Programme community</p>
          <h2>Researchers and contributors</h2>
        </div>
        <p class="section-note">
          Profiles present concise institutional roles and research interests,
          with links to official university pages where available.
        </p>
      </div>
      <div class="people-grid">
        {
          people.map((person) => (
            <PersonCard
              person={person}
              institutionName={
                person.data.institution
                  ? institutionsById.get(person.data.institution.id)?.data.name
                  : undefined
              }
            />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
