---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PersonCard from "../../components/PersonCard.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import InstitutionMark from "../../components/InstitutionMark.astro";
import { sitePath } from "../../lib/site";

export async function getStaticPaths() {
  const institutions = await getCollection("institutions");
  return institutions.map((institution) => ({
    params: { id: institution.id },
    props: { institution },
  }));
}

interface Props {
  institution: CollectionEntry<"institutions">;
}

const { institution } = Astro.props;
const { Content } = await render(institution);
const [people, projects] = await Promise.all([
  getCollection("people"),
  getCollection("projects"),
]);
const linkedPeople = people.filter(
  (person) => person.data.institution?.id === institution.id,
);
const linkedProjects = projects.filter((project) =>
  project.data.institutions.some(
    (reference) => reference.id === institution.id,
  ),
);
---

<BaseLayout
  title={institution.data.name}
  description={institution.data.summary}
>
  <section class="page-hero">
    <div class="shell page-hero__inner">
      <p class="breadcrumb">
        <a href={sitePath("/partners-contact/")}>Institutions / Contact</a><span
          aria-hidden="true">/</span
        >Institution
      </p>
      <div class="card-meta">
        <span>{institution.data.kind}</span>
      </div>
      <InstitutionMark institution={institution} />
      <h1>{institution.data.name}</h1>
      <p class="page-hero__intro">{institution.data.summary}</p>
    </div>
  </section>

  <section class="section">
    <div class="shell detail-layout">
      <article class="prose"><Content /></article>
      <aside class="detail-sidebar" aria-label="Institution details">
        <div class="detail-sidebar__block">
          <p class="detail-label">Relationship</p>
          <p>{institution.data.relationship}</p>
        </div>
        {
          institution.data.countryOrRegion && (
            <div class="detail-sidebar__block">
              <p class="detail-label">Location</p>
              <p>{institution.data.countryOrRegion}</p>
            </div>
          )
        }
        {
          institution.data.website && (
            <a href={institution.data.website}>
              Visit official website <span aria-hidden="true">↗</span>
            </a>
          )
        }
        <a href={institution.data.evidenceUrl}>
          View relationship evidence <span aria-hidden="true">↗</span>
        </a>
        {
          institution.data.logo && (
            <a href={institution.data.logo.sourceUrl}>
              {institution.data.logo.sourceLabel}{" "}
              <span aria-hidden="true">↗</span>
            </a>
          )
        }
      </aside>
    </div>
  </section>

  {
    (linkedPeople.length > 0 || linkedProjects.length > 0) && (
      <section class="section section--tint">
        <div class="shell">
          <div class="section-heading">
            <p class="eyebrow">Connected records</p>
            <h2>People and research</h2>
          </div>
          {linkedPeople.length > 0 && (
            <div class="people-grid">
              {linkedPeople.map((person) => (
                <PersonCard
                  person={person}
                  institutionName={institution.data.name}
                />
              ))}
            </div>
          )}
          {linkedProjects.length > 0 && (
            <div class="project-grid related-grid">
              {linkedProjects.map((project) => (
                <ProjectCard project={project} />
              ))}
            </div>
          )}
        </div>
      </section>
    )
  }
</BaseLayout>
