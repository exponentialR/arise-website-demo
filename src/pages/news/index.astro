---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import NewsCard from "../../components/NewsCard.astro";

const news = (await getCollection("news"))
  .filter((item) => !item.data.demo)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title="News"
  description="News and updates from the ARISE research programme."
>
  <PageHeader
    eyebrow="News"
    title="Updates from across the programme."
    intro="Research developments, programme activity and updates from across the ARISE collaboration."
  />

  <section class="section">
    <div class="shell">
      <div class="section-heading section-heading--row">
        <div>
          <p class="eyebrow">Latest updates</p>
          <h2>Programme news</h2>
        </div>
      </div>
      {
        news.length > 0 ? (
          <div class="news-grid">
            {news.map((item) => (
              <NewsCard item={item} />
            ))}
          </div>
        ) : (
          <p class="empty-state">
            Programme updates will appear here as they are published.
          </p>
        )
      }
    </div>
  </section>
</BaseLayout>
