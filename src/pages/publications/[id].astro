---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import DemoBadge from "../../components/DemoBadge.astro";
import { sitePath } from "../../lib/site";

export async function getStaticPaths() {
  const publications = await getCollection("publications");
  return publications.map((publication) => ({
    params: { id: publication.id },
    props: { publication },
  }));
}

interface Props {
  publication: CollectionEntry<"publications">;
}

const { publication } = Astro.props;
const { Content } = await render(publication);
const [people, projects, funders] = await Promise.all([
  getCollection("people"),
  getCollection("projects"),
  getCollection("funders"),
]);
const peopleById = new Map(people.map((person) => [person.id, person]));
const projectsById = new Map(projects.map((project) => [project.id, project]));
const fundersById = new Map(funders.map((funder) => [funder.id, funder]));
---

<BaseLayout
  title={publication.data.title}
  description={publication.data.summary ?? publication.data.title}
>
  <section class="page-hero page-hero--publication">
    <div class="shell page-hero__inner">
      <p class="breadcrumb">
        <a href={sitePath("/publications/")}>Publications</a><span
          aria-hidden="true">/</span
        >{publication.data.year}
      </p>
      <div class="card-meta">
        <span>{publication.data.type}</span>
        {publication.data.demo && <DemoBadge />}
      </div>
      <h1>{publication.data.title}</h1>
      <p class="page-hero__intro">
        {publication.data.authors.map((author) => author.name).join(", ")}
      </p>
    </div>
  </section>

  <section class="section">
    <div class="shell detail-layout">
      <article class="prose">
        {
          publication.data.summary && (
            <p class="lede">{publication.data.summary}</p>
          )
        }
        <Content />
      </article>
      <aside class="detail-sidebar" aria-label="Publication metadata">
        <div class="detail-sidebar__block">
          <p class="detail-label">Year</p>
          <p>{publication.data.year}</p>
        </div>
        <div class="detail-sidebar__block">
          <p class="detail-label">Venue</p>
          <p>{publication.data.venue ?? "Not supplied"}</p>
        </div>
        <div class="detail-sidebar__block">
          <p class="detail-label">Authors</p>
          <ul class="plain-list">
            {
              publication.data.authors.map((author) => {
                const person = author.person
                  ? peopleById.get(author.person.id)
                  : undefined;
                return (
                  <li>
                    {person ? (
                      <a href={sitePath(`/people/${person.id}/`)}>
                        {author.name}
                      </a>
                    ) : (
                      author.name
                    )}
                  </li>
                );
              })
            }
          </ul>
        </div>
        {
          publication.data.funding.length > 0 && (
            <div class="detail-sidebar__block">
              <p class="detail-label">Funding evidence</p>
              <ul class="plain-list funding-reference-list">
                {publication.data.funding.map((reference) => {
                  const funder = fundersById.get(reference.funder.id);
                  return funder ? (
                    <li>
                      <a href={sitePath(`/funding/${funder.id}/`)}>
                        {funder.data.shortName} {reference.award}
                      </a>
                      <small>{reference.evidence}</small>
                      <a class="evidence-link" href={reference.evidenceUrl}>
                        View evidence <span aria-hidden="true">↗</span>
                      </a>
                    </li>
                  ) : null;
                })}
              </ul>
            </div>
          )
        }
        <div class="detail-sidebar__block">
          <p class="detail-label">Related projects</p>
          {
            publication.data.projects.length > 0 ? (
              <ul class="plain-list">
                {publication.data.projects.map((reference) => {
                  const project = projectsById.get(reference.id);
                  return project ? (
                    <li>
                      <a href={sitePath(`/research/${project.id}/`)}>
                        {project.data.title}
                      </a>
                    </li>
                  ) : null;
                })}
              </ul>
            ) : (
              <p>No project-level relationship is asserted.</p>
            )
          }
        </div>
        {
          (publication.data.doi || publication.data.externalUrl) && (
            <div class="detail-sidebar__block">
              <p class="detail-label">External record</p>
              <a
                href={
                  publication.data.externalUrl ??
                  `https://doi.org/${publication.data.doi}`
                }
              >
                View publication <span aria-hidden="true">↗</span>
              </a>
            </div>
          )
        }
      </aside>
    </div>
  </section>
</BaseLayout>
