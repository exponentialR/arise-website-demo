---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import PublicationItem from "../../components/PublicationItem.astro";
import { sitePath } from "../../lib/site";

const [publications, projects, funders] = await Promise.all([
  getCollection("publications"),
  getCollection("projects"),
  getCollection("funders"),
]);
publications.sort(
  (a, b) =>
    b.data.year - a.data.year || a.data.title.localeCompare(b.data.title),
);
const projectsById = new Map(projects.map((project) => [project.id, project]));
const years = [
  ...new Set(publications.map((publication) => publication.data.year)),
].sort((a, b) => b - a);
const types = [
  ...new Set(publications.map((publication) => publication.data.type)),
].sort();
funders.sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
---

<BaseLayout
  title="Publications"
  description="ARISE publications and research outputs, connected to authors, institutions and funding evidence."
>
  <PageHeader
    eyebrow="Publications"
    title="Research outputs, connected to the people behind them."
    intro="Browse journal articles and conference papers connected to their authors, research areas and supporting awards."
  />

  <section class="section">
    <div class="shell">
      <div class="filter-panel" aria-label="Publication groupings">
        <div>
          <p class="detail-label">Browse by year</p>
          <div class="filter-links">
            {years.map((year) => <a href={`#year-${year}`}>{year}</a>)}
          </div>
        </div>
        <div>
          <p class="detail-label">Types represented</p>
          <div class="filter-links">
            {types.map((type) => <span>{type}</span>)}
          </div>
        </div>
        <div>
          <p class="detail-label">Browse by funding</p>
          <div class="filter-links">
            {
              funders.map((funder) => (
                <a href={sitePath(`/funding/${funder.id}/`)}>
                  {funder.data.shortName}
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <div class="section-heading section-heading--row publication-heading">
        <div>
          <p class="eyebrow">Research catalogue</p>
          <h2>
            {publications.length} research output{
              publications.length === 1 ? "" : "s"
            }
          </h2>
        </div>
        <p class="section-note">
          Publication metadata is drawn from publisher records and official
          proceedings.
        </p>
      </div>

      {
        years.map((year) => (
          <section
            class="year-group"
            id={`year-${year}`}
            aria-labelledby={`year-${year}-heading`}
          >
            <h3 id={`year-${year}-heading`}>{year}</h3>
            <div class="publication-list">
              {publications
                .filter((publication) => publication.data.year === year)
                .map((publication) => (
                  <PublicationItem
                    publication={publication}
                    authorNames={publication.data.authors.map(
                      (author) => author.name,
                    )}
                    projectNames={publication.data.projects.map(
                      (reference) =>
                        projectsById.get(reference.id)?.data.title ??
                        reference.id,
                    )}
                  />
                ))}
            </div>
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>
