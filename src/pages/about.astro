---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { sitePath } from "../lib/site";
---

<BaseLayout
  title="About"
  description="About ARISE and its interdisciplinary research in steel building assembly."
>
  <PageHeader
    eyebrow="About the programme"
    title="Assembly and robotics innovation in steel building erection."
    intro="ARISE is an interdisciplinary research programme exploring intermeshed steel connections, advanced manufacturing, structural performance, robotic assembly and the human dimensions of technology adoption."
  />

  <section class="section">
    <div class="shell split-layout">
      <div>
        <p class="eyebrow">Programme purpose</p>
        <h2>Connecting the disciplines shaping future steel assembly.</h2>
      </div>
      <div class="prose lead-prose">
        <p>
          ARISE connects research in structural engineering, manufacturing,
          robotics and human-centred technology adoption around the challenge of
          steel building erection.
        </p>
        <p>
          The programme brings its research community, projects, publications,
          engagement activity and supporting resources into a single connected
          view.
        </p>
      </div>
    </div>
  </section>

  <section
    class="section section--tint"
    aria-labelledby="research-context-heading"
  >
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">Research context</p>
        <h2 id="research-context-heading">
          A connected view of future steel assembly.
        </h2>
      </div>
      <div class="principle-grid">
        <article>
          <span class="principle-grid__number">01</span>
          <h3>Connections and manufacture</h3>
          <p>
            Study how intermeshed steel connections can be designed, produced
            and assembled, including the relationship between connection
            geometry and manufacturing processes.
          </p>
        </article>
        <article>
          <span class="principle-grid__number">02</span>
          <h3>Robotics and perception</h3>
          <p>
            Explore computer vision, machine learning, simulation and robotic
            manipulation for steel connection assembly.
          </p>
        </article>
        <article>
          <span class="principle-grid__number">03</span>
          <h3>Performance, safety and adoption</h3>
          <p>
            Connect structural modelling and physical testing with questions of
            safety, ergonomics, skills, cost and technology adoption.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="approach-heading">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">Programme approach</p>
        <h2 id="approach-heading">
          Research across systems, scales and people.
        </h2>
      </div>
      <div class="principle-grid">
        <article>
          <span class="principle-grid__number">01</span>
          <h3>International collaboration</h3>
          <p>
            Researchers across partner institutions contribute complementary
            expertise to a shared programme of work.
          </p>
        </article>
        <article>
          <span class="principle-grid__number">02</span>
          <h3>Connected research</h3>
          <p>
            Projects connect people, institutions, publications and resources so
            related work can be explored in context.
          </p>
        </article>
        <article>
          <span class="principle-grid__number">03</span>
          <h3>Public engagement</h3>
          <p>
            Presentations, workshops and outreach create routes for research
            exchange with academic, industry and public audiences.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell callout-panel">
      <div>
        <p class="eyebrow">Research in focus</p>
        <h2>Explore ARISE research and its published outputs.</h2>
      </div>
      <div>
        <p>
          Follow verified publications through to their authors, institutions
          and funding evidence.
        </p>
        <a class="button" href={sitePath("/publications/")}
          >Browse publications</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
