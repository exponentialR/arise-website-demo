---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { sitePath } from "../lib/site";

const [resources, projects] = await Promise.all([
  getCollection("resources"),
  getCollection("projects"),
]);
const publishedResources = resources
  .filter((resource) => !resource.data.demo)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const projectsById = new Map(projects.map((project) => [project.id, project]));
---

<BaseLayout
  title="Resources"
  description="A catalogue of ARISE datasets, software, repositories, videos and guides."
>
  <PageHeader
    eyebrow="Research resources"
    title="A front door to datasets, software and practical outputs."
    intro="Large assets remain in suitable repositories or archives. This site provides durable descriptions, research context and verified links to them."
  />

  <section class="section">
    <div class="shell">
      <div class="section-heading section-heading--row">
        <div>
          <p class="eyebrow">Resource catalogue</p>
          <h2>Find an output</h2>
        </div>
        <p class="section-note">
          Datasets, software, repositories, videos and guides are linked from
          their authoritative host platforms.
        </p>
      </div>
      <div class="resource-grid">
        {
          publishedResources.map((resource) => (
            <article class="resource-card">
              <div class="card-meta">
                <span>{resource.data.type}</span>
              </div>
              <h3>{resource.data.title}</h3>
              <p>{resource.data.summary}</p>
              {resource.data.projects.length > 0 && (
                <p class="resource-card__projects">
                  Related research:{" "}
                  {resource.data.projects.map((reference) => {
                    const project = projectsById.get(reference.id);
                    return project ? (
                      <a href={sitePath(`/research/${project.id}/`)}>
                        {project.data.title}
                      </a>
                    ) : null;
                  })}
                </p>
              )}
              {resource.data.externalUrl ? (
                <a class="card-link" href={resource.data.externalUrl}>
                  Open resource <span aria-hidden="true">↗</span>
                </a>
              ) : (
                <span class="pending-link">
                  External link pending verification
                </span>
              )}
            </article>
          ))
        }
        {
          publishedResources.length === 0 && (
            <p class="empty-state">
              Research resources will appear here as they are published.
            </p>
          )
        }
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="shell split-layout">
      <div>
        <p class="eyebrow">Accessing research outputs</p>
        <h2>Research resources, hosted where they belong.</h2>
      </div>
      <div class="prose lead-prose">
        <p>
          Large datasets, software releases and videos remain in services
          designed for long-term research access and preservation.
        </p>
        <p>
          ARISE provides clear routes to those authoritative repositories,
          archives and publisher platforms.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
