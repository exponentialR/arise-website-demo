---
import type { CollectionEntry } from "astro:content";
import { sitePath } from "../lib/site";

interface Props {
  person: CollectionEntry<"people">;
  institutionName?: string;
}

const { person, institutionName } = Astro.props;
const initials = person.data.name
  .split(" ")
  .map((part) => part[0])
  .join("")
  .slice(0, 2);
const photoUrl = person.data.photo
  ? person.data.photo.url.startsWith("http")
    ? person.data.photo.url
    : sitePath(person.data.photo.url)
  : undefined;
---

<article class="person-card">
  {
    person.data.photo ? (
      <img
        class="person-card__portrait person-card__portrait--image"
        src={photoUrl}
        alt=""
        width="640"
        height="640"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="person-card__portrait" aria-hidden="true">
        {initials}
      </div>
    )
  }
  <div>
    <h3><a href={sitePath(`/people/${person.id}/`)}>{person.data.name}</a></h3>
    <p class="person-card__role">{person.data.role}</p>
    {
      institutionName && (
        <p class="person-card__institution">{institutionName}</p>
      )
    }
    <p class="person-card__summary">{person.data.summary}</p>
    <a class="card-link" href={sitePath(`/people/${person.id}/`)}
      >View profile <span aria-hidden="true">→</span></a
    >
  </div>
</article>
