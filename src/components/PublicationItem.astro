---
import type { CollectionEntry } from "astro:content";
import { sitePath } from "../lib/site";

interface Props {
  publication: CollectionEntry<"publications">;
  authorNames: string[];
  projectNames?: string[];
  fundingEvidence?: Array<{ label: string; url: string }>;
}

const {
  publication,
  authorNames,
  projectNames = [],
  fundingEvidence = [],
} = Astro.props;
---

<article class="publication-item">
  <div class="publication-item__year">{publication.data.year}</div>
  <div class="publication-item__body">
    <div class="card-meta">
      <span>{publication.data.type}</span>
    </div>
    <h3>
      <a href={sitePath(`/publications/${publication.id}/`)}
        >{publication.data.title}</a
      >
    </h3>
    {
      authorNames.length > 0 && (
        <p class="publication-item__authors">{authorNames.join(", ")}</p>
      )
    }
    {
      publication.data.venue && (
        <p class="publication-item__venue">{publication.data.venue}</p>
      )
    }
    {
      projectNames.length > 0 && (
        <p class="publication-item__projects">
          Related research: {projectNames.join(", ")}
        </p>
      )
    }
    {
      fundingEvidence.length > 0 && (
        <p class="publication-item__funding">
          {fundingEvidence.map((evidence, index) => (
            <>
              {index > 0 && " · "}
              <a href={evidence.url}>
                {evidence.label} <span aria-hidden="true">↗</span>
              </a>
            </>
          ))}
        </p>
      )
    }
  </div>
</article>
