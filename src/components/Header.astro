---
import { sitePath } from "../lib/site";

const pathname = Astro.url.pathname;
const items = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about/" },
  { label: "Research", href: "/research/" },
  { label: "People", href: "/people/" },
  { label: "Publications", href: "/publications/" },
  { label: "Engagement", href: "/engagement/" },
  { label: "News", href: "/news/" },
  { label: "Funding", href: "/funding/" },
  { label: "Institutions / Contact", href: "/partners-contact/" },
];

const isCurrent = (href: string) => {
  const resolved = sitePath(href);
  return href === "/"
    ? pathname === resolved || pathname === `${resolved}/`
    : pathname.startsWith(resolved);
};
---

<a class="skip-link" href="#main-content">Skip to main content</a>
<header class="site-header">
  <div class="shell masthead">
    <a class="brand" href={sitePath("/")} aria-label="ARISE home">
      <span class="brand__wordmark">ARISE</span>
      <span class="brand__descriptor"
        >Assembly and Robotics Innovation in Steel Building Erection</span
      >
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      <ul>
        {
          items.map((item) => (
            <li>
              <a
                href={sitePath(item.href)}
                aria-current={isCurrent(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <details class="mobile-nav">
      <summary>Menu</summary>
      <nav aria-label="Mobile navigation">
        <ul>
          {
            items.map((item) => (
              <li>
                <a
                  href={sitePath(item.href)}
                  aria-current={isCurrent(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>
