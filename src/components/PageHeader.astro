---
interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  compact?: boolean;
}

const { eyebrow, title, intro, compact = false } = Astro.props;
---

<section class:list={['page-hero', { 'page-hero--compact': compact }]}> 
  <div class="shell page-hero__inner">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="page-hero__intro">{intro}</p>
    <slot />
  </div>
</section>
