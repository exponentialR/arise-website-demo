---
import type { CollectionEntry } from "astro:content";
import { sitePath } from "../lib/site";

interface Props {
  institution: CollectionEntry<"institutions">;
  showApprovalNote?: boolean;
}

const { institution, showApprovalNote = false } = Astro.props;
const logoUrl = institution.data.logo
  ? sitePath(institution.data.logo.url)
  : undefined;
---

<div class="institution-mark">
  {
    institution.data.logo ? (
      <span
        class:list={[
          "institution-mark__canvas",
          `institution-mark__canvas--${institution.data.logo.background}`,
        ]}
      >
        <img
          src={logoUrl}
          alt={institution.data.logo.alt}
          loading="lazy"
          decoding="async"
        />
      </span>
    ) : (
      <span class="institution-mark__fallback">
        {institution.data.shortName ?? institution.data.name}
      </span>
    )
  }
  {
    showApprovalNote && (
      <small>
        {institution.data.logo
          ? institution.data.logo.usageNote
          : "Typographic mark · official logo approval pending"}
      </small>
    )
  }
</div>
